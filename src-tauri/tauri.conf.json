{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeno",
  "version": "1.0.0",
  "identifier": "dev.zeno.executor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zeno",
        "width": 1180,
        "height": 740,
        "minWidth": 880,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#08080d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/*"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
